rules_version = '2';

// ============================================================
//  Säkerhetsregler för Starten (Firebase-projekt: starten-ba789)
//  ----------------------------------------------------------
//  Lösenordsspärren är klient-sidan (auth.js), så Firestore vet
//  inte vem som är inloggad. Reglerna validerar därför formen
//  på datan istället: rätt fält, rätt typer, rimliga storlekar.
//  Det skyddar mot oavsiktliga fel och små script-attacker.
//  För skarp säkerhet behövs Firebase Auth – dokumenterat i
//  starten/README.md.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------- Idébank: läsförståelse-texter --------
    match /bank/{doc} {
      allow read: if true;

      function bankValid(d) {
        return d.size() <= 8
          && d.subject is string
          && d.subject.size() <= 16
          && d.text is string
          && d.text.size() > 0
          && d.text.size() <= 500
          && d.questions is list
          && d.questions.size() >= 1
          && d.questions.size() <= 5
          && (!('fixedField' in d) || d.fixedField is string)
          && (!('source'     in d) || d.source     is string)
          && (!('createdAt'  in d) || d.createdAt  is string)
          && (!('usage'      in d) || (d.usage is list && d.usage.size() <= 12));
      }

      allow create, update: if bankValid(request.resource.data);
      allow delete: if true;
    }

    // -------- Veckor (en doc per ISO-vecka och årskurs: YYYY-vWW-akN) --------
    //  Äldre veckor saknar -akN-suffix och tillåts fortfarande.
    match /weeks/{weekId} {
      allow read: if true;

      function weekValid(d) {
        return d.size() <= 16
          && d.year is int && d.year >= 2024 && d.year <= 2099
          && d.week is int && d.week >= 1    && d.week <= 53
          && (!('grade'     in d) || d.grade == null || (d.grade is int && d.grade >= 1 && d.grade <= 9))
          && (!('svFormat'  in d) || d.svFormat  is string && d.svFormat.size()  <= 8)
          && (!('veckotext' in d) || d.veckotext is map)
          && (!('name'      in d) || d.name      is string && d.name.size()      <= 80)
          && (!('title'     in d) || d.title     is string && d.title.size()     <= 80)
          && (!('color'     in d) || d.color     is string && d.color.size()     <= 32)
          && (!('archived'  in d) || d.archived  is bool)
          && (!('days'      in d) || (d.days     is list && d.days.size() <= 5))
          && (!('matte'     in d) || d.matte     is map)
          && (!('updatedAt' in d) || d.updatedAt is string);
      }

      allow create, update: if weekValid(request.resource.data)
                             && weekId.matches('^[0-9]{4}-v[0-9]{2}(-ak[0-9])?$');
      allow delete: if true;
    }

    // -------- Alla andra collections: nekas helt --------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
